{
  "name": "@blue/app",
  "version": "0.0.1",
  "description": "Electron application for Blue — loads .blue files and plays via blue-engine",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build": "pnpm --filter @blue/data build && pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "dev": "APP_ENV=dev vite",
    "start": "electron .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@blue/data": "workspace:*",
    "@blue/engine-client": "workspace:*",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@fontsource/roboto": "^5.2.10",
    "@kunstmusik/codemirror-lang-csound": "^1.0.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.10",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dockview": "^5.2.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@electron/remote": "^2.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.23",
    "electron": "^35.7.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.0",
    "vite": "^7.3.2",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.4"
  }
}
