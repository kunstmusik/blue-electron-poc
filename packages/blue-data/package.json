{
  "name": "@blue/data",
  "version": "0.0.1",
  "description": "Core data model for Blue — portable TypeScript data classes with XML serialization compatible with Java .blue files",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^4.2.0"
  },
  "keywords": [
    "csound",
    "music",
    "composition",
    "blue",
    "audio"
  ],
  "author": "Steven Yi",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevenyi/blue-electron"
  }
}
