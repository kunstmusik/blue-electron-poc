	instr 1	;Voice
ifreq = p4
iamp = ampdbfs(p5)
irvb = ampdbfs(-12)
  
;; Signal Generator
kfreq = ifreq * (lfo(gk_blue_auto4, gk_blue_auto5) + 1)
asig = vco2(iamp, kfreq)
asig += vco2(iamp, kfreq * 2, 12)

  
;; Signal Processing
  
